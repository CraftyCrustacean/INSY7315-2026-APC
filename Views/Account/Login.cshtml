@model APCVehicleTracker.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

    <!DOCTYPE html>
       <html lang="en">
            <head>
               <meta charset="utf-8" />
               <meta name="viewport" content="width=device-width, initial-scale=1.0" />

               <title>APC Vehicle Tracker - Login</title>

               
               <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            html, body {
                margin: 0;
                padding: 0;
                width: 100%;
                height: 100%;
            }

            body {
                background: url('/images/login-background.png') no-repeat center center fixed;
                background-size: cover;
                font-family: "Segoe UI", Arial, sans-serif;
            }

            

            .login-header {
                height: 80px;
                width: 100%;
                background-color: #003366;
                display: flex;
                align-items: center;
                padding-left: 30px;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
            }

            .company-logo {
                height: 55px;
                width: auto;
                object-fit: contain;
            }

            

            .login-wrapper {
                min-height: calc(100vh - 80px);
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 40px 20px;
                box-sizing: border-box;
            }

           

            .login-card {
                width: 500px;
                max-width: 90%;
                padding: 50px;
                background: rgba(255, 255, 255, 0.95);
                border-radius: 18px;
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
            }

                .login-card h1 {
                    text-align: center;
                    font-size: 2.2rem;
                    font-weight: 600;
                    color: #003366;
                    margin-bottom: 10px;
                }

                .login-card p {
                    text-align: center;
                    color: #6c757d;
                    font-size: 1.1rem;
                    margin-bottom: 35px;
                }

            

            .form-label {
                font-weight: 600;
            }

            .form-control {
                height: 48px;
                font-size: 1rem;
                border-radius: 8px;
            }

          

            .btn-login {
                width: 100%;
                height: 50px;
                font-size: 1.1rem;
                font-weight: 600;
                border-radius: 8px;
                margin-top: 10px;
            }
         </style>
             </head>

               <body>

    <header class="login-header">

        <img src="~/images/APCLogo.png"
             alt="APC Logo"
             class="company-logo" />

                        </header>


   
    <main class="login-wrapper">

        <div class="login-card">

            <h1>Welcome</h1>

            <p>APC Vehicle Tracker</p>


            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }


            <form asp-action="Login" method="post">

                <div class="mb-3">

                    <label asp-for="Username"
                           class="form-label">
                        Username
                    </label>

                    <input asp-for="Username"
                           class="form-control"
                           placeholder="Enter username" />

                    <span asp-validation-for="Username"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-4">

                    <label asp-for="Password"
                           class="form-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Enter password" />


                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>


                <button type="submit"
                        class="btn btn-primary btn-login">

                    Login

                </button>

            </form>

        </div>

    </main>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
