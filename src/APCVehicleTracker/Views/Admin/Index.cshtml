@model List<StaffDto>
@{
    ViewData["Title"] = "Staff";
}

<h1 class="mb-1">Staff</h1>
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">View, manage, and create staff members</p>
    <a asp-action="Create" class="btn btn-primary">Add staff member</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table align-middle">
    <thead>
        <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.FirstName @s.LastName</td>
                <td>@s.Email</td>
                <td>@StaffRoles.DisplayName(s.Role)</td>
                <td>
                    @if (!s.IsActive)
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                    else if (!s.HasSignIn)
                    {

                        <span class="badge bg-warning text-dark">No sign-in</span>
                    }
                    else
                    {

                        <span class="badge bg-success">Active</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@s.StaffId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    @if (s.HasSignIn)
                    {
                        <form asp-action="ResetPassword" asp-route-id="@s.StaffId" method="post" class="d-inline"
                              onsubmit="return confirm('Reset this staff member\'s password?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Reset password</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
