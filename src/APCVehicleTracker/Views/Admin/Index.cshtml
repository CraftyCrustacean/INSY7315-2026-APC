@model List<StaffDto>
@{
    ViewData["Title"] = "Staff";
}

@functions {
    static (string Text, string Css) Status(StaffDto s) =>
        !s.IsActive ? ("Inactive", "status-pill--inactive")
        : !s.HasSignIn ? ("No sign-in", "status-pill--pending")
        : ("Active", "status-pill--active");
}

<div class="apc-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Staff</h1>
            <p class="page-lead">View, manage, and create staff members</p>
        </div>
        <a asp-action="Create" class="btn btn-charcoal">Add staff member</a>
    </div>

    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-md-none">
        @foreach (var s in Model)
        {
            var status = Status(s);
            <div class="apc-panel p-3 mb-3">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="flex-grow-1 min-w-0">
                        <h2 class="h6 mb-0">@s.FirstName @s.LastName</h2>
                        <div class="text-muted small text-break">@s.Email</div>
                    </div>
                    <span class="status-pill @status.Css">@status.Text</span>
                </div>
                <div class="small text-muted mb-3">@StaffRoles.DisplayName(s.Role)</div>

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@s.StaffId" class="btn btn-ghost flex-fill">Edit</a>
                    @if (s.HasSignIn)
                    {
                        <form asp-action="ResetPassword" asp-route-id="@s.StaffId" method="post" class="flex-fill"
                              data-confirm="Reset the password for @s.FirstName @s.LastName? Their current password will stop working and a new temporary password will be generated."
                              data-confirm-title="Reset password?" data-confirm-button="Reset password" data-confirm-variant="danger">
                            <button type="submit" class="btn btn-outline-danger w-100">Reset password</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    <div class="d-none d-md-block apc-panel">
        <div class="table-responsive">
            <table class="table apc-table table-hover align-middle">
                <thead>
                    <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        var status = Status(s);
                        <tr>
                            <td class="fw-semibold">@s.FirstName @s.LastName</td>
                            <td class="text-muted">@s.Email</td>
                            <td>@StaffRoles.DisplayName(s.Role)</td>
                            <td><span class="status-pill @status.Css">@status.Text</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@s.StaffId" class="btn btn-sm btn-ghost">Edit</a>
                                @if (s.HasSignIn)
                                {
                                    <form asp-action="ResetPassword" asp-route-id="@s.StaffId" method="post" class="d-inline"
                                          data-confirm="Reset the password for @s.FirstName @s.LastName? Their current password will stop working and a new temporary password will be generated."
                                          data-confirm-title="Reset password?" data-confirm-button="Reset password" data-confirm-variant="danger">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Reset password</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
