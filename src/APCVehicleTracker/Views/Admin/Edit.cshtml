@model UpdateStaffRequest
@{
    ViewData["Title"] = "Edit staff member";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">

        <h1 class="mb-1">Edit staff member</h1>
        @if (ViewData["Email"] is string email)
        {
            <p class="text-muted mb-2">Editing user with email: @email</p>
        }

        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@(ViewContext.RouteData.Values["id"])" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label">First name</label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label">Last name</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Phone" class="form-label">Phone <span class="text-muted">(optional)</span></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Role" class="form-label">Role</label>
                            <select asp-for="Role" class="form-select"
                                    asp-items="@(StaffRoles.All.Select(r => new SelectListItem(StaffRoles.DisplayName(r), r)))">
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-action="Index" class="btn btn-link">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

        @if (ViewData["IsActive"] is bool isActive)
        {
            var isSelf = ViewData["IsSelf"] is true;
            var confirmText = isActive
                ? "Deactivate this account? The user will lose access to the app."
                : "Reactivate this account?";

            <div class="card shadow-sm mt-4">
                <div class="card-body d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                    <div>
                        <h2 class="h5 mb-1">Account access</h2>
                        <p class="text-muted mb-0">
                            @(isActive ? "This account is active and can sign in." : "This account is deactivated and cannot sign in.")
                        </p>
                    </div>

                    @if (isSelf)
                    {
                        <span class="text-muted small">You cannot deactivate your own account.</span>
                    }
                    else
                    {
                        <form asp-action="SetActive" asp-route-id="@(ViewContext.RouteData.Values["id"])" method="post"
                              onsubmit="return confirm('@confirmText');">
                            <input type="hidden" name="active" value="@(isActive ? "false" : "true")" />
                            <button type="submit" class="btn @(isActive ? "btn-outline-danger" : "btn-outline-success")">
                                @(isActive ? "Deactivate" : "Reactivate")
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
