@model TemporaryPasswordResponse
@{
    ViewData["Title"] = "Temporary password";
}

<h1>Temporary password</h1>

<div class="alert alert-warning">
    This password is shown once and isn't stored anywhere. Give it to the staff member
    in person or by private message. They'll be asked to choose their own password when they first sign in.
</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Staff.FirstName @Model.Staff.LastName</dd>
    <dt class="col-sm-3">Sign-in email</dt>
    <dd class="col-sm-9">@Model.Staff.Email</dd>
    <dt class="col-sm-3">Role</dt>
    <dd class="col-sm-9">@StaffRoles.DisplayName(Model.Staff.Role)</dd>
    <dt class="col-sm-3">Temporary password</dt>
    <dd class="col-sm-9"><code class="fs-4">@Model.TemporaryPassword</code></dd>
</dl>

<a asp-action="Index" class="btn btn-primary">Back to staff list</a>
