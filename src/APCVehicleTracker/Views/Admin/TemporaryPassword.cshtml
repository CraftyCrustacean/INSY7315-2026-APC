@model TemporaryPasswordResponse
@{
    ViewData["Title"] = "Temporary password";
}

<div class="apc-page apc-page--narrow">
    <div class="page-header">
        <div>
            <h1 class="page-title">Temporary password</h1>
        </div>
    </div>

    <div class="alert alert-warning">
        This password is shown once and isn't stored anywhere. Give it to the staff member
        in person or by private message. They'll be asked to choose their own password when they sign in.
    </div>

    <div class="apc-panel p-4">
        <dl class="detail-list">
            <div class="detail-row">
                <dt>Name</dt>
                <dd>@Model.Staff.FirstName @Model.Staff.LastName</dd>
            </div>
            <div class="detail-row">
                <dt>Sign-in email</dt>
                <dd class="text-break">@Model.Staff.Email</dd>
            </div>
            <div class="detail-row">
                <dt>Role</dt>
                <dd>@StaffRoles.DisplayName(Model.Staff.Role)</dd>
            </div>
            <div class="detail-row">
                <dt>Temporary password</dt>
                <dd>
                    <div class="temp-password">
                        <code id="temp-password-value">@Model.TemporaryPassword</code>
                        <button type="button" class="temp-password__copy" data-copy-target="temp-password-value"
                                aria-label="Copy password" title="Copy password">
                            <svg class="icon-copy" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" /></svg>
                            <svg class="icon-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5 10 17.5 19 7" /></svg>
                        </button>
                        <span class="visually-hidden" aria-live="polite" data-copy-status></span>
                    </div>
                </dd>
            </div>
        </dl>

        <div class="d-flex justify-content-end mt-4">
            <a asp-action="Index" class="btn btn-charcoal">Back</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll("[data-copy-target]").forEach(btn => {
            const status = btn.parentElement.querySelector("[data-copy-status]");
            let resetTimer;

            btn.addEventListener("click", async () => {
                const target = document.getElementById(btn.dataset.copyTarget);
                try {
                    await navigator.clipboard.writeText(target.textContent.trim());
                    btn.classList.add("is-copied");
                    btn.title = "Copied";
                    status.textContent = "Password copied to clipboard";
                } catch {
                    const range = document.createRange();
                    range.selectNodeContents(target);
                    const selection = window.getSelection();
                    selection.removeAllRanges();
                    selection.addRange(range);
                    btn.title = "Press Ctrl+C to copy";
                    status.textContent = "Password selected, press Ctrl+C to copy";
                }

                clearTimeout(resetTimer);
                resetTimer = setTimeout(() => {
                    btn.classList.remove("is-copied");
                    btn.title = "Copy password";
                    status.textContent = "";
                }, 2000);
            });
        });
    </script>
}
