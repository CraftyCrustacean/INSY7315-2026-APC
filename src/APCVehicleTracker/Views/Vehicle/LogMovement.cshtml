@model APCVehicleTracker.Models.Vehicle
@{
    ViewData["Title"] = "Log Movement";
}

<h4>Log Movement — @Model.Make @Model.Model (@Model.RegistrationNumber)</h4>

<div class="card shadow-sm mt-3" style="max-width:600px;">
    <div class="card-body">
        <form>
            <div class="mb-3">
                <label class="form-label">From Location</label>
                <input type="text" class="form-control" value="@Model.CurrentLocation" readonly />
            </div>
            <div class="mb-3">
                <label class="form-label">To Location</label>
                <select class="form-select">
                    <option>Showroom</option>
                    <option>Workshop</option>
                    <option>Detailing</option>
                    <option>Wash Bay</option>
                    <option>Storage Yard</option>
                    <option>Panel Shop</option>
                    <option>Tyres</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Moved By</label>
                <input type="text" class="form-control" placeholder="Staff member name" />
            </div>
            <div class="mb-3">
                <label class="form-label">Notes</label>
                <textarea class="form-control" rows="3"></textarea>
            </div>
            <button type="submit" class="btn btn-apc">Save Movement</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>