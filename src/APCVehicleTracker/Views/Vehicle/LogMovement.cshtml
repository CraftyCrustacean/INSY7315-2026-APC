@model APCVehicleTracker.Models.Vehicle

@{
    ViewData["Title"] = "Log movement";

    var destinationLocations =
        ViewBag.DestinationLocations
        as List<APCVehicleTracker.Models.LocationViewModel>
        ?? new List<APCVehicleTracker.Models.LocationViewModel>();

    var availableStatuses =
        ViewBag.AvailableStatuses
        as List<string>
        ?? new List<string>();

    var hasLocation = !string.IsNullOrWhiteSpace(Model.CurrentLocation);
}

<div class="apc-page apc-page--narrow">
    <div class="page-header">
        <div>
            <h1 class="page-title">Log movement</h1>
            <p class="page-lead">@Model.Year @Model.Make @Model.Model &middot; @Model.RegistrationNumber</p>
        </div>
    </div>

    <div class="apc-panel p-4">
        <form asp-controller="Vehicle" asp-action="LogMovement" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="fromLocation">From location</label>
                    <input type="text" id="fromLocation" class="form-control"
                           value="@(hasLocation ? Model.CurrentLocation : "No current location (new vehicle)")" readonly />
                    <div class="form-text">
                        @(hasLocation
                            ? "Taken from the vehicle's current location."
                            : "This vehicle has no movements yet. Its first movement sets its starting location.")
                    </div>
                </div>

                <div class="col-md-6">
                    <label for="toLocationId" class="form-label">To location</label>
                    <select id="toLocationId" name="toLocationId" class="form-select" required>
                        <option value="">Select a destination…</option>
                        @foreach (var location in destinationLocations)
                        {
                            <option value="@location.LocationId">@location.LocationName</option>
                        }
                    </select>
                    @Html.ValidationMessage("toLocationId", new { @class = "text-danger small" })
                </div>

                <div class="col-12">
                    <label for="newStatus" class="form-label">New status</label>
                    <select id="newStatus" name="newStatus" class="form-select">
                        <option value="">Keep current status (@Model.Status)</option>
                        @foreach (var status in availableStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>

                <div class="col-12">
                    <label for="notes" class="form-label">Notes <span class="text-muted">(optional)</span></label>
                    <textarea id="notes" name="notes" class="form-control" rows="3" maxlength="500"></textarea>
                    <div class="form-text">Maximum 500 characters.</div>
                    @Html.ValidationMessage("notes", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-charcoal" data-busy-text="Saving…">Save movement</button>
            </div>
        </form>
    </div>
</div>
