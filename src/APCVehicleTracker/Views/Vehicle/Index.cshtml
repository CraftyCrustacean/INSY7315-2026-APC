@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model APCVehicleTracker.Models.VehicleSearchViewModel

@{
    ViewData["Title"] = "Vehicles";

    const int pageSize = 25;
    var totalPages = (int)Math.Ceiling(Model.TotalCount / (double)pageSize);

    const int minYear = 1990;
    var maxYear = DateTime.Now.Year + 1;
    var yearFrom = Math.Clamp(Model.YearFrom ?? minYear, minYear, maxYear);
    var yearTo = Math.Clamp(Model.YearTo ?? maxYear, minYear, maxYear);

    var routeData = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(Model.Search)) routeData["search"] = Model.Search;
    if (!string.IsNullOrWhiteSpace(Model.Make)) routeData["make"] = Model.Make;
    if (!string.IsNullOrWhiteSpace(Model.Model)) routeData["model"] = Model.Model;
    if (Model.YearFrom.HasValue) routeData["yearFrom"] = Model.YearFrom.Value.ToString();
    if (Model.YearTo.HasValue) routeData["yearTo"] = Model.YearTo.Value.ToString();
    var selectedStatus = Model.Status.FirstOrDefault(s => !string.IsNullOrWhiteSpace(s));
    if (selectedStatus != null) routeData["status"] = selectedStatus;
    var selectedLocation = Model.Location.FirstOrDefault(l => l > 0);
    if (selectedLocation > 0) routeData["location"] = selectedLocation.ToString();
    if (Model.IncludeSold) routeData["includeSold"] = "true";

    var hasFilters = routeData.Count > 0;

    var canEditVehicles =
        (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanEditVehicles)).Succeeded;
    var canReactivate =
        (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanReactivateVehicles)).Succeeded;
}

<div class="apc-page apc-page--wide">
    <div class="page-header">
        <div>
            <h1 class="page-title">Vehicles</h1>
            <p class="page-lead">Browse, filter, and manage vehicle stock</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (canReactivate)
            {
                <a asp-controller="ManageVehicles" asp-action="Inactive" class="btn btn-ghost">Inactive vehicles</a>
            }
            @if (canEditVehicles)
            {
                <a asp-controller="ManageVehicles" asp-action="Create" class="btn btn-charcoal">Add vehicle</a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="vehicles-layout">
        <aside class="vehicles-filters">
            <div class="apc-panel filter-panel search-panel">
                <label class="form-label" for="searchInput">Search</label>
                <div class="search-field">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                    <input type="search" name="search" id="searchInput" class="form-control" value="@Model.Search"
                           form="filterForm" placeholder="VIN or registration" maxlength="30"
                           autocomplete="off" autocapitalize="characters" spellcheck="false" />
                </div>
            </div>

            <button class="btn btn-ghost w-100 d-lg-none mb-3" type="button"
                    data-bs-toggle="collapse" data-bs-target="#vehicleFilters"
                    aria-expanded="false" aria-controls="vehicleFilters">
                Filters@(hasFilters ? " (active)" : "")
            </button>

            <div class="collapse d-lg-block" id="vehicleFilters">
                <form method="get" asp-controller="Vehicle" asp-action="Index" class="apc-panel filter-panel" id="filterForm">
                    <h2 class="section-label">Filters</h2>

                    <div class="mb-3">
                        <label class="form-label" for="makeSelect">Make</label>
                        <select name="make" class="form-select" id="makeSelect">
                            <option value="">All makes</option>
                            @foreach (var make in Model.AvailableMakes)
                            {
                                <option value="@make" selected="@(Model.Make == make)">@make</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="modelSelect">Model</label>
                        <select name="model" class="form-select" id="modelSelect">
                            <option value="">All models</option>
                            @foreach (var modelName in Model.AvailableModels)
                            {
                                <option value="@modelName" selected="@(Model.Model == modelName)">@modelName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="form-label mb-0" id="yearLabel">Year</span>
                            <span class="year-range__value" id="yearValue" aria-live="polite"></span>
                        </div>
                        <div class="year-range" data-min="@minYear" data-max="@maxYear">
                            <div class="year-range__track"><div class="year-range__fill"></div></div>
                            <input type="range" name="yearFrom" min="@minYear" max="@maxYear" step="1" value="@yearFrom"
                                   aria-label="Year from" />
                            <input type="range" name="yearTo" min="@minYear" max="@maxYear" step="1" value="@yearTo"
                                   aria-label="Year to" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="statusSelect">Status</label>
                        <select name="status" class="form-select" id="statusSelect">
                            <option value="">All statuses</option>
                            @foreach (var status in Model.AvailableStatuses)
                            {
                                <option value="@status" selected="@(Model.Status.Contains(status))">@status</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="locationSelect">Location</label>
                        <select name="location" class="form-select" id="locationSelect">
                            <option value="">All locations</option>
                            @foreach (var location in Model.AvailableLocations)
                            {
                                <option value="@location.LocationId" selected="@(Model.Location.Contains(location.LocationId))">
                                    @location.LocationName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="form-check mb-4">
                        <input type="checkbox" name="includeSold" value="true" class="form-check-input" id="includeSold"
                               @(Model.IncludeSold ? "checked" : "") />
                        <label class="form-check-label" for="includeSold">Include sold vehicles</label>
                    </div>

                    <a asp-controller="Vehicle" asp-action="Index" class="btn btn-charcoal w-100">Clear filters</a>
                </form>
            </div>
        </aside>

        <section class="vehicles-results" aria-label="Vehicles">
            <p class="results-count">
                <strong>@Model.TotalCount</strong> @(Model.TotalCount == 1 ? "vehicle" : "vehicles")
                @(hasFilters ? "match your filters" : "in stock")
            </p>

            @if (!Model.Vehicles.Any())
            {
                <div class="apc-panel p-4 text-center text-muted">
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <text>No vehicles have a VIN or registration containing “@Model.Search”@(routeData.Count > 1 ? " with these filters" : "").</text>
                    }
                    else
                    {
                        <text>No vehicles match these filters.</text>
                    }
                </div>
            }
            else
            {
                <div class="vehicle-grid">
                    @foreach (var vehicle in Model.Vehicles)
                    {
                        <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@vehicle.VehicleId" class="vehicle-card">
                            @if (!string.IsNullOrWhiteSpace(vehicle.PrimaryImage))
                            {
                                <img src="@Url.Action("Get", "Images", new { blobName = vehicle.PrimaryImage, thumb = true })"
                                     class="vehicle-card__img" alt="@vehicle.Make @vehicle.Model" loading="lazy" />
                            }
                            else
                            {
                                <div class="vehicle-card__img vehicle-card__img--empty">No image</div>
                            }

                            <div class="vehicle-card__body">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="min-w-0">
                                        <h2 class="vehicle-card__title">
                                            @vehicle.Make
                                            <span class="vehicle-card__model">@vehicle.Model</span>
                                        </h2>
                                        <div class="vehicle-card__year">@vehicle.Year</div>
                                    </div>
                                    <span class="status-pill @VehicleStatusStyles.PillCss(vehicle.Status)">@vehicle.Status</span>
                                </div>

                                <dl class="vehicle-card__meta">
                                    <div><dt>Reg</dt><dd>@vehicle.Registration</dd></div>
                                    <div><dt>Location</dt><dd>@(vehicle.CurrentLocation ?? "Unknown")</dd></div>
                                    <div>
                                        <dt>At location</dt>
                                        <dd>@(vehicle.DaysAtCurrentLocation is int days ? $"{days} {(days == 1 ? "day" : "days")}" : "N/A")</dd>
                                    </div>
                                </dl>
                            </div>
                        </a>
                    }
                </div>

                @if (totalPages > 1)
                {
                    <nav class="results-pager" aria-label="Vehicle results pages">
                        @if (Model.Page > 1)
                        {
                            <a class="btn btn-ghost" asp-controller="Vehicle" asp-action="Index"
                               asp-all-route-data="routeData" asp-route-page="@(Model.Page - 1)">Previous</a>
                        }
                        else
                        {
                            <span class="btn btn-ghost disabled" aria-disabled="true">Previous</span>
                        }

                        <span class="text-muted small">Page @Model.Page of @totalPages</span>

                        @if (Model.Page < totalPages)
                        {
                            <a class="btn btn-ghost" asp-controller="Vehicle" asp-action="Index"
                               asp-all-route-data="routeData" asp-route-page="@(Model.Page + 1)">Next</a>
                        }
                        else
                        {
                            <span class="btn btn-ghost disabled" aria-disabled="true">Next</span>
                        }
                    </nav>
                }
            }
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('filterForm');
            const filters = document.getElementById('vehicleFilters');
            const search = document.getElementById('searchInput');

            function apply() {
                if (filters.classList.contains('show')) {
                    try { sessionStorage.setItem('vehicleFiltersOpen', '1'); } catch { }
                }
                form.requestSubmit();
            }

            try {
                if (sessionStorage.getItem('vehicleFiltersOpen')) {
                    sessionStorage.removeItem('vehicleFiltersOpen');
                    filters.classList.add('show');
                    document.querySelector('[data-bs-target="#vehicleFilters"]')?.setAttribute('aria-expanded', 'true');
                }
            } catch { }

            let rangeTimer;
            form.addEventListener('change', e => {
                if (e.target.type === 'range') {
                    clearTimeout(rangeTimer);
                    rangeTimer = setTimeout(apply, 600);
                    return;
                }
                if (e.target.id === 'makeSelect') document.getElementById('modelSelect').value = '';
                apply();
            });

            search.addEventListener('keydown', e => {
                if (e.key === 'Enter' && !e.isComposing) { e.preventDefault(); apply(); }
            });
            search.addEventListener('search', () => { if (!search.value) apply(); });

            const range = form.querySelector('.year-range');
            const min = Number(range.dataset.min);
            const max = Number(range.dataset.max);
            const [from, to] = range.querySelectorAll('input[type=range]');
            const fill = range.querySelector('.year-range__fill');
            const output = document.getElementById('yearValue');

            function update(moved) {
                if (Number(from.value) > Number(to.value)) {
                    if (moved === from) from.value = to.value; else to.value = from.value;
                }
                const a = Number(from.value), b = Number(to.value);
                fill.style.left = ((a - min) / (max - min) * 100) + '%';
                fill.style.right = (100 - (b - min) / (max - min) * 100) + '%';

                from.style.zIndex = a >= max - (max - min) / 2 ? 3 : 2;

                const lo = a <= min ? 'Any' : a;
                const hi = b >= max ? 'Any' : b;
                output.textContent = lo === 'Any' && hi === 'Any' ? 'All years'
                    : a === b ? String(a)
                    : `${lo} – ${hi}`;
                from.setAttribute('aria-valuetext', a <= min ? 'Any' : String(a));
                to.setAttribute('aria-valuetext', b >= max ? 'Any' : String(b));
            }

            from.addEventListener('input', () => update(from));
            to.addEventListener('input', () => update(to));
            update();

            form.addEventListener('submit', () => {
                if (Number(from.value) <= min) from.disabled = true;
                if (Number(to.value) >= max) to.disabled = true;
                if (!search.value.trim()) search.disabled = true;
            });
            window.addEventListener('pageshow', () => { from.disabled = false; to.disabled = false; search.disabled = false; });
        })();
    </script>
}
