@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model APCVehicleTracker.Models.VehicleSearchViewModel

@{
    ViewData["Title"] = "Vehicle Search";

    // The API always returns 25 results per page.
    const int pageSize = 25;
    var totalPages = (int)Math.Ceiling(Model.TotalCount / (double)pageSize);

    // Keeps the current filters on the Previous/Next links.
    var routeData = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(Model.Make)) routeData["make"] = Model.Make;
    if (!string.IsNullOrWhiteSpace(Model.Model)) routeData["model"] = Model.Model;
    if (Model.YearFrom.HasValue) routeData["yearFrom"] = Model.YearFrom.Value.ToString();
    if (Model.YearTo.HasValue) routeData["yearTo"] = Model.YearTo.Value.ToString();
    var selectedStatus = Model.Status.FirstOrDefault(s => !string.IsNullOrWhiteSpace(s));
    if (selectedStatus != null) routeData["status"] = selectedStatus;
    var selectedLocation = Model.Location.FirstOrDefault(l => l > 0);
    if (selectedLocation > 0) routeData["location"] = selectedLocation.ToString();
    if (Model.IncludeSold) routeData["includeSold"] = "true";

    var canLogMovements =
        (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanLogMovements)).Succeeded;
    var canEditVehicles =
        (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanEditVehicles)).Succeeded;
    var canReactivate =
        (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanReactivateVehicles)).Succeeded;
}

<div class="container mt-4">

    <h1 class="mb-4">Vehicle Search</h1>

    <div class="d-flex gap-2">
            @if (canEditVehicles)
            {
                <a asp-controller="ManageVehicles" asp-action="Create" class="btn btn-apc">Add Vehicle</a>
            }
            @if (canReactivate)
            {
                <a asp-controller="ManageVehicles" asp-action="Inactive" class="btn btn-outline-secondary">Inactive Vehicles</a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <form method="get" asp-controller="Vehicle" asp-action="Search">

        <div class="row g-3">

            <div class="col-md-3">
                <label class="form-label">Make</label>
                <select name="make" class="form-select" id="makeSelect">
                    <option value="">All Makes</option>

                    @foreach (var make in Model.AvailableMakes)
                    {
                        <option value="@make" selected="@(Model.Make == make)">
                            @make
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Model</label>
                <select name="model" class="form-select" id="modelSelect">
                    <option value="">All Models</option>

                    @foreach (var modelName in Model.AvailableModels)
                    {
                        <option value="@modelName" selected="@(Model.Model == modelName)">
                            @modelName
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Year From</label>
                <input type="number"
                       name="yearFrom"
                       value="@Model.YearFrom"
                       class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Year To</label>
                <input type="number"
                       name="yearTo"
                       value="@Model.YearTo"
                       class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>

                    @foreach (var status in Model.AvailableStatuses)
                    {
                        <option value="@status" selected="@(Model.Status.Contains(status))">
                            @status
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Location</label>
                <select name="location" class="form-select">
                    <option value="">All Locations</option>

                    @foreach (var location in Model.AvailableLocations)
                    {
                        <option value="@location.LocationId"
                                selected="@(Model.Location.Contains(location.LocationId))">
                            @location.LocationName
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check">
                    <input type="checkbox"
                           name="includeSold"
                           value="true"
                           class="form-check-input"
                           id="includeSold"
                    @(Model.IncludeSold ? "checked" : "") />

                    <label class="form-check-label" for="includeSold">
                        Include sold vehicles
                    </label>
                </div>
            </div>

            <div class="col-md-4 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                <a asp-controller="Vehicle"
                   asp-action="Search"
                   class="btn btn-secondary">
                    Clear Filters
                </a>
            </div>

        </div>
    </form>

    <hr class="my-4" />

    <div class="mb-3">
        <strong>@Model.TotalCount</strong> vehicle(s) found
    </div>

    @if (!Model.Vehicles.Any())
    {
        <div class="alert alert-info">
            No matching vehicles found.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var vehicle in Model.Vehicles)
            {
                <div class="col-md-4">

                    <div class="card h-100">

                        @if (!string.IsNullOrWhiteSpace(vehicle.PrimaryImage))
                        {
                            <img src="@Url.Action("Get", "Images", new { blobName = vehicle.PrimaryImage, thumb = true })"
                                 loading="lazy"
                                 class="card-img-top"
                                 alt="@vehicle.Make @vehicle.Model"
                                 style="height:220px; object-fit:cover;" />

                        }

                        <div class="card-body">

                            <h5 class="card-title">
                                @vehicle.Make @vehicle.Model
                            </h5>

                            <p class="card-text">
                                <strong>Year:</strong> @vehicle.Year<br />
                                <strong>Registration:</strong> @vehicle.Registration<br />
                                <strong>Status:</strong> @vehicle.Status<br />
                                <strong>Location:</strong>
                                @(vehicle.CurrentLocation ?? "Unknown")<br />
                                <strong>Days at location:</strong>
                                @(vehicle.DaysAtCurrentLocation?.ToString() ?? "N/A")
                            </p>

                            <a asp-controller="Vehicle"
                               asp-action="Details"
                               asp-route-id="@vehicle.VehicleId"
                               class="btn btn-primary">
                                View Details
                            </a>

                            @* Saheel Ramone Bhugwandeen - Feature 3: Log Movement *@
                            @if (canLogMovements && vehicle.Status != "Sold")
                            {
                                <a asp-controller="Vehicle"
                                   asp-action="LogMovement"
                                   asp-route-id="@vehicle.VehicleId"
                                   class="btn btn-apc">
                                    Log Movement
                                </a>
                            }
                            @* Chase Miller - Feature 5: CRUD *@
                            @if (canEditVehicles)
                            {
                                <a asp-controller="ManageVehicles"
                                   asp-action="Edit"
                                   asp-route-id="@vehicle.VehicleId"
                                   class="btn btn-outline-primary">
                                    Edit
                                </a>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-4" aria-label="Search results pages">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-controller="Vehicle"
                           asp-action="Search"
                           asp-all-route-data="routeData"
                           asp-route-page="@(Model.Page - 1)">Previous</a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">Page @Model.Page of @totalPages</span>
                    </li>
                    <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-controller="Vehicle"
                           asp-action="Search"
                           asp-all-route-data="routeData"
                           asp-route-page="@(Model.Page + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@section Scripts {
    <script>
        // Reload when the make changes so the Model dropdown shows that make's models.
        document.getElementById('makeSelect').addEventListener('change', function() {
            document.getElementById('modelSelect').value = '';
            this.form.submit();
        });
    </script>
}