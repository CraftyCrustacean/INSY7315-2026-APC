@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model APCVehicleTracker.Models.Vehicle
@{
    ViewData["Title"] = $"{Model.Make} {Model.Model}";
    var history = ViewBag.MovementHistory as List<APCVehicleTracker.Models.MovementRecord>;
    var canLogMovements =
        (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanLogMovements)).Succeeded;
    var canEditVehicles =
        (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanEditVehicles)).Succeeded;
    var canReactivate =
        (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanReactivateVehicles)).Succeeded;

    var vehiclesUrl = Url.Action("Index", "Vehicle")!;
    var backUrl = vehiclesUrl;
    if (Uri.TryCreate(Context.Request.Headers.Referer.ToString(), UriKind.Absolute, out var referer)
        && referer.Host == Context.Request.Host.Host
        && (referer.AbsolutePath.Equals(vehiclesUrl, StringComparison.OrdinalIgnoreCase)
            || referer.AbsolutePath.Equals(vehiclesUrl + "/Index", StringComparison.OrdinalIgnoreCase)))
    {
        backUrl = referer.PathAndQuery;
    }

    var hasActions = (Model.IsActive && ((canLogMovements && Model.Status != "Sold") || canEditVehicles))
                     || (!Model.IsActive && canReactivate);
}

<div class="apc-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">@Model.Make @Model.Model</h1>
            <p class="page-lead d-flex flex-wrap align-items-center gap-2">
                <span>@Model.Year &middot; @Model.RegistrationNumber</span>
                <span class="status-pill @VehicleStatusStyles.PillCss(Model.Status)">@Model.Status</span>
            </p>
        </div>

        <a href="@backUrl" class="btn btn-charcoal">Back</a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!Model.IsActive)
    {
        <div class="alert alert-warning" role="status">This vehicle is inactive (deleted).</div>
    }

    <div class="row g-4">
        <div class="col-12 col-lg-5">
            <div class="apc-panel">
                @if (!string.IsNullOrWhiteSpace(Model.PrimaryImage))
                {
                    <img src="@Url.Action("Get", "Images", new { blobName = Model.PrimaryImage })"
                         class="vehicle-detail__img" alt="@Model.Make @Model.Model" />
                }
                else
                {
                    <div class="vehicle-detail__img vehicle-card__img--empty">No image</div>
                }

                @if (hasActions)
                {
                    <div class="d-flex flex-wrap gap-2 px-4 pt-4">
                        @* Saheel Ramone Bhugwandeen - Feature 3: Log Movement *@
                        @if (Model.IsActive && canLogMovements && Model.Status != "Sold")
                        {
                            <a asp-action="LogMovement" asp-route-id="@Model.Id" class="btn btn-charcoal">Log movement</a>
                        }
                        @if (Model.IsActive && canEditVehicles)
                        {
                            <a asp-controller="ManageVehicles" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-ghost">Edit</a>
                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteVehicleModal">Delete</button>
                        }
                        @if (!Model.IsActive && canReactivate)
                        {
                            <form asp-controller="ManageVehicles" asp-action="Reactivate" asp-route-id="@Model.Id" method="post">
                                <button type="submit" class="btn btn-charcoal" data-busy-text="Reactivating…">Reactivate</button>
                            </form>
                        }
                    </div>
                }

                <dl class="detail-list p-4">
                    <div class="detail-row"><dt>Make</dt><dd>@Model.Make</dd></div>
                    <div class="detail-row"><dt>Model</dt><dd>@Model.Model</dd></div>
                    <div class="detail-row"><dt>Year</dt><dd>@Model.Year</dd></div>
                    <div class="detail-row"><dt>Registration</dt><dd>@Model.RegistrationNumber</dd></div>
                    <div class="detail-row"><dt>VIN</dt><dd class="text-break">@Model.VinNumber</dd></div>
                    <div class="detail-row">
                        <dt>Location</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.CurrentLocation) ? "Unknown" : Model.CurrentLocation)</dd>
                    </div>
                    <div class="detail-row">
                        <dt>Last moved</dt>
                        <dd>@(Model.LastMoved == DateTime.MinValue ? "Not yet moved" : Model.LastMoved.ToString("dd MMM yyyy"))</dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="col-12 col-lg-7 history-col">
            <div class="apc-panel history-panel">
                <h2 class="section-label px-4 pt-4 mb-3">Movement history</h2>

                @if (history != null && history.Any())
                {
                    <div class="history-scroll" tabindex="0" aria-label="Movement history">
                        <ul class="list-unstyled mb-0 d-md-none">
                            @foreach (var h in history)
                            {
                                <li class="movement-item">
                                    <div class="d-flex justify-content-between gap-2">
                                        <span class="fw-semibold">@h.FromLocation &rarr; @h.ToLocation</span>
                                        <span class="text-muted small text-nowrap">@h.MovementDate.ToString("dd MMM yyyy")</span>
                                    </div>
                                    <div class="text-muted small">@h.MovedBy</div>
                                    @if (!string.IsNullOrWhiteSpace(h.Notes))
                                    {
                                        <div class="small mt-1">@h.Notes</div>
                                    }
                                </li>
                            }
                        </ul>

                        <div class="d-none d-md-block">
                            <table class="table apc-table align-middle">
                                <thead>
                                    <tr><th>Date</th><th>From</th><th>To</th><th>Moved by</th><th>Notes</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in history)
                                    {
                                        <tr>
                                            <td class="text-nowrap">@h.MovementDate.ToString("dd MMM yyyy")</td>
                                            <td>@h.FromLocation</td>
                                            <td>@h.ToLocation</td>
                                            <td>@h.MovedBy</td>
                                            <td class="text-muted">@h.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted px-4 pb-4 mb-0">No movement history recorded yet.</p>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.IsActive && canEditVehicles)
{
    @await Html.PartialAsync("_DeleteVehicleModal",
        new APCVehicleTracker.Models.DeleteVehicleModalModel(
            Model.Id, $"{Model.Year} {Model.Make} {Model.Model} ({Model.RegistrationNumber})"))
}
