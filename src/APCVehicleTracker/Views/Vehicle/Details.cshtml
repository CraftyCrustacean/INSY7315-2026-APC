@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model APCVehicleTracker.Models.Vehicle
@{
    ViewData["Title"] = "Vehicle Details";
    var history = ViewBag.MovementHistory as List<APCVehicleTracker.Models.MovementRecord>;
    var canLogMovements =
        (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanLogMovements)).Succeeded;
    var canEditVehicles =
        (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanEditVehicles)).Succeeded;
    var canReactivate =
        (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanReactivateVehicles)).Succeeded;
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row">
    <div class="col-12 col-lg-5">
        <div class="card shadow-sm mb-3">
            @if (!string.IsNullOrWhiteSpace(Model.PrimaryImage))
            {
                <img src="@Url.Action("Get", "Images", new { blobName = Model.PrimaryImage })"
                     class="card-img-top"
                     alt="@Model.Make @Model.Model"
                     style="max-height:320px; object-fit:cover;" />
            }
            <div class="card-body">
                @if (!Model.IsActive)
                {
                    <div class="alert alert-warning py-2">This vehicle is inactive (deleted).</div>
                }
                <h4>@Model.Make @Model.Model (@Model.Year)</h4>
                <p><strong>Registration:</strong> @Model.RegistrationNumber</p>
                <p><strong>VIN:</strong> @Model.VinNumber</p>
                <p><strong>Current Location:</strong> @Model.CurrentLocation</p>
                <p><strong>Status:</strong> @Model.Status</p>

                @* Saheel Ramone Bhugwandeen - Feature 3: Log Movement *@
                @if (Model.IsActive && canLogMovements && Model.Status != "Sold")
                {
                    <a asp-action="LogMovement" asp-route-id="@Model.Id" class="btn btn-apc">Log New Movement</a>
                }
                @if (Model.IsActive && canEditVehicles)
                {
                    <a asp-controller="ManageVehicles" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteVehicleModal">Delete</button>
                }
                @if (!Model.IsActive && canReactivate)
                {
                    <form asp-controller="ManageVehicles" asp-action="Reactivate" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-success">Reactivate</button>
                    </form>
                }

                <a asp-controller="Vehicle" asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <h5>Movement History</h5>
        @if (history != null && history.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-sm bg-white">
                    <thead>
                        <tr><th>Date</th><th>From</th><th>To</th><th>Moved By</th><th>Notes</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var h in history)
                        {
                            <tr>
                                <td>@h.MovementDate.ToString("dd MMM yyyy")</td>
                                <td>@h.FromLocation</td>
                                <td>@h.ToLocation</td>
                                <td>@h.MovedBy</td>
                                <td>@h.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">No movement history recorded yet.</p>
        }
    </div>
</div>
@if (Model.IsActive && canEditVehicles)
{
    @await Html.PartialAsync("_DeleteVehicleModal",
        new APCVehicleTracker.Models.DeleteVehicleModalModel(
            Model.Id, $"{Model.Year} {Model.Make} {Model.Model} ({Model.RegistrationNumber})"))
}