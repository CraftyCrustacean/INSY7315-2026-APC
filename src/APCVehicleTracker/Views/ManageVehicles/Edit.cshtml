@model APCVehicleTracker.Models.VehicleFormViewModel
@{
    ViewData["Title"] = "Edit vehicle";
    var images = Model.Images.OrderBy(i => i.SortOrder).ToList();
    var canUpload = images.Count < 5;
}

<div class="apc-page apc-page--narrow">
    <div class="page-header">
        <div>
            <h1 class="page-title">Edit vehicle</h1>
            <p class="page-lead">@Model.Year @Model.Make @Model.Model &middot; @Model.Registration</p>
        </div>
        <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@Model.VehicleId" class="btn btn-charcoal">Back</a>
    </div>

    @if (TempData["SuccessMessage"] is string ok)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ok
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string bad)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @bad
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="apc-panel p-4">
        <form asp-action="Edit" asp-route-id="@Model.VehicleId" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <h2 class="section-label">Vehicle details</h2>
            <partial name="_VehicleFields" model="Model" />

            <div class="mt-3">
                <label class="form-label" for="currentLocation">Current location</label>
                <input class="form-control" id="currentLocation" value="@(Model.CurrentLocation ?? "Unknown")" disabled />
                <div class="form-text">
                    Location can only be changed by
                    <a asp-controller="Vehicle" asp-action="LogMovement" asp-route-id="@Model.VehicleId">logging a movement</a>.
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@Model.VehicleId" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-charcoal" data-busy-text="Saving…">Save changes</button>
            </div>
        </form>
    </div>

    <div class="apc-panel p-4 mt-4">
        <div class="d-flex justify-content-between align-items-baseline mb-1">
            <h2 class="section-label mb-0">Images</h2>
            <span class="text-muted small">@images.Count of 5</span>
        </div>
        <p class="text-muted small mb-3">JPEG or PNG, up to 5 MB each. The first image becomes the primary image.</p>

        @if (images.Any())
        {
            <div class="row g-3 mb-4">
                @foreach (var (image, index) in images.Select((img, i) => (img, i)))
                {
                    <div class="col-6 col-md-4">
                        <div class="image-tile @(image.IsPrimary ? "image-tile--primary" : "")">
                            <img src="@Url.Action("Get", "Images", new { blobName = image.BlobName, thumb = true })"
                                 alt="Vehicle image @(index + 1)" loading="lazy" />
                            <div class="p-2">
                                @if (image.IsPrimary)
                                {
                                    <span class="status-pill status-pill--active mb-2">Primary</span>
                                }

                                <div class="d-flex flex-wrap gap-1">
                                    @if (!image.IsPrimary)
                                    {
                                        <form asp-action="SetPrimary" asp-route-id="@Model.VehicleId" method="post">
                                            <input type="hidden" name="imageId" value="@image.ImageId" />
                                            <button class="btn btn-sm btn-ghost">Make primary</button>
                                        </form>
                                    }

                                    <form asp-action="MoveImage" asp-route-id="@Model.VehicleId" method="post">
                                        <input type="hidden" name="imageId" value="@image.ImageId" />
                                        <input type="hidden" name="direction" value="up" />
                                        <button class="btn btn-sm btn-ghost" title="Move earlier" aria-label="Move earlier" disabled="@(index == 0)">&uarr;</button>
                                    </form>
                                    <form asp-action="MoveImage" asp-route-id="@Model.VehicleId" method="post">
                                        <input type="hidden" name="imageId" value="@image.ImageId" />
                                        <input type="hidden" name="direction" value="down" />
                                        <button class="btn btn-sm btn-ghost" title="Move later" aria-label="Move later" disabled="@(index == images.Count - 1)">&darr;</button>
                                    </form>

                                    <form asp-action="DeleteImage" asp-route-id="@Model.VehicleId" method="post"
                                          data-confirm="This image will be permanently deleted from the vehicle. This can't be undone."
                                          data-confirm-title="Delete image?" data-confirm-button="Delete image" data-confirm-variant="danger">
                                        <input type="hidden" name="imageId" value="@image.ImageId" />
                                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (canUpload)
        {
            <form asp-action="UploadImages" asp-route-id="@Model.VehicleId" method="post" enctype="multipart/form-data" id="uploadForm">
                <label class="form-label" for="imageFiles">Add images</label>
                <div class="input-group">
                    <input type="file" name="files" class="form-control" accept="image/jpeg,image/png" multiple required id="imageFiles" />
                    <button class="btn btn-charcoal" type="submit" data-busy-text="Uploading…">Upload</button>
                </div>
                <div class="text-danger small mt-1" id="uploadError"></div>
            </form>
        }
        else
        {
            <div class="alert alert-info mb-0">This vehicle has the maximum of 5 images. Delete one to add another.</div>
        }
    </div>

    <div class="apc-panel p-4 mt-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
        <div>
            <h2 class="h5 mb-1">Delete vehicle</h2>
            <p class="text-muted mb-0">Hides the vehicle from search and reports. An admin can reactivate it later.</p>
        </div>
        <button type="button" class="btn btn-outline-danger text-nowrap" data-bs-toggle="modal" data-bs-target="#deleteVehicleModal">
            Delete vehicle
        </button>
    </div>
</div>

@await Html.PartialAsync("_DeleteVehicleModal",
    new APCVehicleTracker.Models.DeleteVehicleModalModel(
        Model.VehicleId, $"{Model.Year} {Model.Make} {Model.Model} ({Model.Registration})"))

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Convenience only - the API re-validates size, count and file signature.
        document.getElementById('uploadForm')?.addEventListener('submit', function (e) {
            const files = document.getElementById('imageFiles').files;
            const remaining = @(5 - images.Count);
            const error = document.getElementById('uploadError');
            error.textContent = '';

            if (files.length > remaining) {
                error.textContent = 'You can add at most ' + remaining + ' more image(s).';
                e.preventDefault();
                return;
            }
            for (const f of files) {
                if (f.size > 5 * 1024 * 1024) {
                    error.textContent = 'Each image must be 5 MB or smaller.';
                    e.preventDefault();
                    return;
                }
            }
        });
    </script>
}
