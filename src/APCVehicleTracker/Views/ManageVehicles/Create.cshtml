@model APCVehicleTracker.Models.VehicleFormViewModel
@{
    ViewData["Title"] = "Add vehicle";
}

<div class="apc-page apc-page--narrow">
    <div class="page-header">
        <div>
            <h1 class="page-title">Add vehicle</h1>
            <p class="page-lead">Enter the vehicle's details and where it's starting from</p>
        </div>
    </div>

    <div class="apc-panel p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data" id="createVehicleForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <h2 class="section-label">Vehicle details</h2>
            <partial name="_VehicleFields" model="Model" />

            <hr class="my-4" />

            <h2 class="section-label mb-1">Starting location</h2>
            <p class="text-muted small mb-3">Saved as the vehicle's first movement. After this, location can only be changed by logging a movement.</p>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="StartingLocationId" class="form-label"></label>
                    <select asp-for="StartingLocationId" class="form-select">
                        <option value="0">Select a location…</option>
                        @foreach (var location in Model.AvailableLocations)
                        {
                            <option value="@location.LocationId" selected="@(location.LocationId == Model.StartingLocationId)">@location.LocationName</option>
                        }
                    </select>
                    <span asp-validation-for="StartingLocationId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Notes" class="form-label"></label>
                    <input asp-for="Notes" class="form-control" maxlength="500" />
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" />

            <h2 class="section-label mb-1">Images <span class="text-muted fw-normal text-lowercase">(optional)</span></h2>
            <p class="text-muted small mb-3">Up to 5 JPEG or PNG images, 5 MB each. The first image becomes the primary image. You can reorder or add more later.</p>

            <label class="form-label visually-hidden" for="imageFiles">Images</label>
            <input type="file" name="files" class="form-control" accept="image/jpeg,image/png" multiple id="imageFiles" />
            <span class="text-danger small" id="uploadError">@Html.ValidationMessage("files")</span>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-controller="Vehicle" asp-action="Index" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-charcoal" data-busy-text="Adding…">Add vehicle</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Convenience only - the server and API re-validate size, count and file signature.
        document.getElementById('createVehicleForm').addEventListener('submit', function (e) {
            const files = document.getElementById('imageFiles').files;
            const error = document.getElementById('uploadError');
            error.textContent = '';

            if (files.length > 5) {
                error.textContent = 'You can add at most 5 images.';
                e.preventDefault();
                return;
            }
            for (const f of files) {
                if (f.size > 5 * 1024 * 1024) {
                    error.textContent = 'Each image must be 5 MB or smaller.';
                    e.preventDefault();
                    return;
                }
            }
        });
    </script>
}
