@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Home";
    var canManageUsers =
        (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanManageUsers)).Succeeded;
    var canViewReports =
        (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanViewReports)).Succeeded;
}

<section class="home-hero">
    <div class="home-hero__intro">
        <h1 class="home-title">Vehicle Stock Tracker</h1>
        <p class="home-lead">
            Manage stock levels, workshop status and view reports.
        </p>
    </div>

    <div class="home-actions">
        <a asp-controller="Vehicle" asp-action="Index" class="home-tile home-tile--primary">
            <span class="home-tile__icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
            </span>
            <span class="home-tile__body">
                <span class="home-tile__title">Vehicles</span>
                <span class="home-tile__text">Browse, filter and manage vehicle stock</span>
            </span>
        </a>

        @if (canViewReports)
        {
            <a asp-controller="Reports" asp-action="Index" class="home-tile">
                <span class="home-tile__icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/></svg>
                </span>
                <span class="home-tile__body">
                    <span class="home-tile__title">Reports</span>
                    <span class="home-tile__text">Stock and sales insights</span>
                </span>
            </a>
        }

        @if (canManageUsers)
        {
            <a asp-controller="Admin" asp-action="Index" class="home-tile">
                <span class="home-tile__icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="4"/><path d="M2 21a7 7 0 0 1 14 0"/><path d="M16 3.5a4 4 0 0 1 0 9"/><path d="M22 21a7 7 0 0 0-4-6.3"/></svg>
                </span>
                <span class="home-tile__body">
                    <span class="home-tile__title">Staff</span>
                    <span class="home-tile__text">Manage users and access</span>
                </span>
            </a>
        }
    </div>
</section>
