@{
    ViewData["Title"] = "Access not granted";
}

<div class="apc-page apc-page--narrow">
    <div class="apc-panel p-5 text-center">
        <h1 class="page-title">Access not granted</h1>
        <p class="page-lead mb-4">Your account isn't set up for this system. Contact an administrator.</p>
        <a asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignIn" class="btn btn-charcoal">
            Sign in with a different account
        </a>
    </div>
</div>
