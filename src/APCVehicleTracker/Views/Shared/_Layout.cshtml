@using Microsoft.AspNetCore.Authorization
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService

@{
    var isHome =
        ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
        ViewContext.RouteData.Values["action"]?.ToString() == "Index";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - APC Vehicle Tracker</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isHome ? "home-bg" : "")">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark apc-navbar">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/APCLogo.png" alt="APC Cars" height="45" class="me-2" />
                    <span class="d-none d-md-inline">Vehicle Stock Tracker</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Vehicle" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Vehicle" asp-action="Search">Search</a></li>
                        @if ((await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanViewReports)).Succeeded)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a></li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanManageUsers)).Succeeded)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Staff</a></li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignOut"
                                   data-confirm="Are you sure you want to sign out of the Vehicle Stock Tracker?"
                                   data-confirm-title="Sign out?"
                                   data-confirm-button="Sign out">Sign out</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container-fluid px-5 px-lg-6 py-4">
        @RenderBody()
    </main>

    <footer class="text-center text-muted py-3 mt-4 border-top">
        &copy; @DateTime.Now.Year - APC Car Sales Vehicle Stock Tracker
    </footer>

    @* Shared confirmation dialog. Add data-confirm="message" to any link or form to use it.
       Optional: data-confirm-title, data-confirm-button (button text), data-confirm-variant="danger". *@
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="confirmModalLabel">Are you sure?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0" data-confirm-message></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-charcoal" data-confirm-ok>Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const el = document.getElementById("confirmModal");
            if (!el || !window.bootstrap) return;

            const modal = bootstrap.Modal.getOrCreateInstance(el);
            const title = el.querySelector("#confirmModalLabel");
            const message = el.querySelector("[data-confirm-message]");
            const ok = el.querySelector("[data-confirm-ok]");
            let onConfirm = null;

            function open(trigger, action) {
                title.textContent = trigger.dataset.confirmTitle || "Are you sure?";
                message.textContent = trigger.dataset.confirm;
                ok.textContent = trigger.dataset.confirmButton || "Confirm";
                ok.className = "btn " + (trigger.dataset.confirmVariant === "danger" ? "btn-danger" : "btn-charcoal");
                onConfirm = action;
                modal.show();
            }

            document.addEventListener("click", e => {
                const link = e.target.closest("a[data-confirm]");
                if (!link) return;
                e.preventDefault();
                open(link, () => { window.location.href = link.href; });
            });

            document.addEventListener("submit", e => {
                const form = e.target.closest("form[data-confirm]");
                if (!form) return;
                e.preventDefault();
                // form.submit() skips the submit event, so this doesn't loop
                open(form, () => form.submit());
            });

            ok.addEventListener("click", () => {
                const action = onConfirm;
                onConfirm = null;
                modal.hide();
                action?.();
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>