@using Microsoft.AspNetCore.Authorization
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var isHome =
        controller == "Home" &&
        ViewContext.RouteData.Values["action"]?.ToString() == "Index";

    var section = controller switch
    {
        "Vehicle" or "ManageVehicles" => "Vehicles",
        "Reports" => "Reports",
        "Admin" => "Staff",
        _ => null
    };
    string NavCss(string name) => section == name ? "nav-link active" : "nav-link";
    string? NavCurrent(string name) => section == name ? "page" : null;

    var userName = User.FindFirst("name")?.Value
                   ?? User.FindFirst("preferred_username")?.Value
                   ?? User.Identity?.Name;
    var roleClaimType = (User.Identity as System.Security.Claims.ClaimsIdentity)?.RoleClaimType;
    var userRole = roleClaimType == null
        ? null
        : User.FindAll(roleClaimType).Select(c => c.Value).FirstOrDefault(r => StaffRoles.All.Contains(r));
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - APC Vehicle Tracker</title>
    <link rel="icon" href="~/favicon.ico" sizes="16x16 32x32 48x48" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isHome ? "home-bg" : "")">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark apc-navbar">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/APCLogo.png" alt="APC Cars" height="45" class="me-2" />
                    <span class="d-none d-md-inline">Vehicle Stock Tracker</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="@NavCss("Vehicles")" aria-current="@NavCurrent("Vehicles")" asp-controller="Vehicle" asp-action="Index">Vehicles</a></li>
                        @if ((await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanViewReports)).Succeeded)
                        {
                            <li class="nav-item"><a class="@NavCss("Reports")" aria-current="@NavCurrent("Reports")" asp-controller="Reports" asp-action="Index">Reports</a></li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, AuthPolicies.CanManageUsers)).Succeeded)
                        {
                            <li class="nav-item"><a class="@NavCss("Staff")" aria-current="@NavCurrent("Staff")" asp-controller="Admin" asp-action="Index">Staff</a></li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown nav-account">
                                <button type="button" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    @userName
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end apc-dropdown">
                                    @if (userRole != null)
                                    {
                                        <li>
                                            <div class="dropdown-header">
                                                <span class="d-block small">User role: </span>
                                                <span class="apc-dropdown__role">@StaffRoles.DisplayName(userRole)</span>
                                            </div>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    <li>
                                        <a class="dropdown-item" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignOut"
                                           data-confirm="Are you sure you want to sign out of the Vehicle Stock Tracker?"
                                           data-confirm-title="Sign out?"
                                           data-confirm-button="Sign out">Sign out</a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container-fluid px-3 px-md-4 px-lg-5 py-4">
        @RenderBody()
    </main>

    <footer class="text-center text-muted py-3 mt-4 border-top">
        &copy; @DateTime.Now.Year - APC Car Sales Vehicle Stock Tracker
    </footer>
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="confirmModalLabel">Are you sure?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0" data-confirm-message></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-charcoal" data-confirm-ok>Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function lockForm(form) {
            setTimeout(() => {
                form.querySelectorAll("button[type=submit], button:not([type])").forEach(btn => {
                    btn.dataset.idleText ??= btn.textContent;
                    btn.disabled = true;
                    btn.setAttribute("aria-busy", "true");
                    btn.textContent = btn.dataset.busyText || "Please wait…";
                });
            });
        }

        document.addEventListener("submit", e => {
            const form = e.target;
            // Skip GET forms (filters), anything stopped by validation, and data-confirm forms
            // (those are locked once the user confirms, further down)
            if (e.defaultPrevented || form.method.toLowerCase() !== "post" || form.hasAttribute("data-confirm")) return;
            lockForm(form);
        });

        // Pages restored with the back button come back with the buttons still locked
        window.addEventListener("pageshow", e => {
            if (!e.persisted) return;
            document.querySelectorAll("button[aria-busy=true]").forEach(btn => {
                btn.disabled = false;
                btn.removeAttribute("aria-busy");
                btn.textContent = btn.dataset.idleText;
            });
        });
    </script>
    <script>
        (() => {
            const el = document.getElementById("confirmModal");
            if (!el || !window.bootstrap) return;

            const modal = bootstrap.Modal.getOrCreateInstance(el);
            const title = el.querySelector("#confirmModalLabel");
            const message = el.querySelector("[data-confirm-message]");
            const ok = el.querySelector("[data-confirm-ok]");
            let onConfirm = null;

            function open(trigger, action) {
                title.textContent = trigger.dataset.confirmTitle || "Are you sure?";
                message.textContent = trigger.dataset.confirm;
                ok.textContent = trigger.dataset.confirmButton || "Confirm";
                ok.className = "btn " + (trigger.dataset.confirmVariant === "danger" ? "btn-danger" : "btn-charcoal");
                onConfirm = action;
                modal.show();
            }

            document.addEventListener("click", e => {
                const link = e.target.closest("a[data-confirm]");
                if (!link) return;
                e.preventDefault();
                open(link, () => { window.location.href = link.href; });
            });

            document.addEventListener("submit", e => {
                const form = e.target.closest("form[data-confirm]");
                if (!form) return;
                e.preventDefault();
                // form.submit() skips the submit event, so this doesn't loop
                open(form, () => { lockForm(form); form.submit(); });
            });

            ok.addEventListener("click", () => {
                const action = onConfirm;
                onConfirm = null;
                modal.hide();
                action?.();
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>