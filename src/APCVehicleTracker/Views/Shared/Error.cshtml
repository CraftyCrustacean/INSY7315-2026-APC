@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="apc-page apc-page--narrow">
    <div class="apc-panel p-5 text-center">
        <h1 class="page-title">Something went wrong</h1>
        <p class="page-lead mb-4">
            An error occurred while processing your request. Please try again, or contact an administrator if it keeps happening.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted small">
                Request ID: <code>@Model.RequestId</code>
            </p>
        }

        <a asp-controller="Vehicle" asp-action="Index" class="btn btn-charcoal">Back to vehicles</a>
    </div>
</div>
